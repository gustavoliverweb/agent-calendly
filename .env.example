# Copia este archivo a .env.local y rellénalo. Nunca subas .env.local al repositorio.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=            # https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # clave "anon" o "publishable" (pública, protegida por RLS)
SUPABASE_SERVICE_ROLE_KEY=           # clave "service_role" o "secret": SOLO servidor
SUPABASE_PROJECT_REF=                # <ref> de la URL, para `supabase link`
SUPABASE_DB_PASSWORD=                # contraseña de la base de datos elegida al crear el proyecto

# --- ElevenLabs ---
ELEVENLABS_API_KEY=                  # Lanzar llamadas
ELEVENLABS_AGENT_ID=                 # Agente a usar
ELEVENLABS_PHONE_NUMBER_ID=          # Transitorio: línea de la empresa principal si no tiene una asignada en /admin
ELEVENLABS_WEBHOOK_SECRET=           # Verificar firma del webhook post-llamada

# --- Calendly (ver docs/configuracion-calendly.md) ---
CALENDLY_TOKEN=                      # Personal Access Token (plan Standard o superior)
CALENDLY_EVENT_TYPE_URI=             # pnpm calendly tipos → https://api.calendly.com/event_types/XXXX
CALENDLY_WEBHOOK_SIGNING_KEY=        # openssl rand -hex 32; se usa al crear el webhook
CALENDLY_LOCATION_KIND=              # Ubicación del tipo de evento (google_conference, physical, outbound_call…); sin ella Calendly rechaza la reserva
CALENDLY_LOCATION=                   # Opcional: dirección o texto de esa ubicación
# Las cinco de arriba son el Calendly "de entorno" de la empresa principal, transitorio:
# en cuanto la principal conecte su cuenta desde el panel (sección Calendly) dejan de usarse.

# --- Calendly OAuth (una app de la plataforma; cada empresa conecta su cuenta) ---
CALENDLY_OAUTH_CLIENT_ID=            # Developer tools → OAuth apps (se muestran una sola vez)
CALENDLY_OAUTH_CLIENT_SECRET=
CALENDLY_OAUTH_WEBHOOK_SIGNING_KEY=  # Clave de firma de webhooks de la app OAuth
ENCRYPTION_KEY=                      # openssl rand -base64 32; cifra los tokens en la BD (no cambiarla: se perderían)

# --- App ---
APP_URL=http://localhost:3000
TOOLS_SECRET=                        # Bearer de /api/tools/*  (openssl rand -hex 32)
CRON_SECRET=                         # Bearer de /api/cron/*   (openssl rand -hex 32)
COSTE_MINUTO_ESTIMADO=0.12            # USD/min que cobra ElevenLabs al proveedor (solo /admin; la tarifa de cada empresa se fija en su ficha)
# --- Marca blanca (opcional) ---
# Dominio base: cada empresa entra por <slug>.<BASE_DOMAIN> (CNAME comodín *.<dominio> hacia Render).
BASE_DOMAIN=
# Otros hosts de la plataforma además del de APP_URL (separados por comas): landing y /admin.
PLATFORM_HOSTS=
# Destino del CNAME de los dominios de empresa (por defecto, el host de APP_URL si es *.onrender.com).
RENDER_SERVICE_HOST=
# API de Render para dar de alta los dominios de empresa desde /admin (sin ella, a mano en Render).
RENDER_API_KEY=
RENDER_SERVICE_ID=                   # srv-…
INVITACIONES_POR_EMAIL=false        # true cuando Supabase Auth tenga SMTP propio (si no, el panel muestra el enlace)
