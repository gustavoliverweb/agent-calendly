# Copia este archivo a .env.local y rellénalo. Nunca subas .env.local al repositorio.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=            # https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # clave "anon" o "publishable" (pública, protegida por RLS)
SUPABASE_SERVICE_ROLE_KEY=           # clave "service_role" o "secret": SOLO servidor
SUPABASE_PROJECT_REF=                # <ref> de la URL, para `supabase link`
SUPABASE_DB_PASSWORD=                # contraseña de la base de datos elegida al crear el proyecto

# --- ElevenLabs ---
ELEVENLABS_API_KEY=                  # Lanzar llamadas
ELEVENLABS_AGENT_ID=                 # Agente a usar
ELEVENLABS_PHONE_NUMBER_ID=          # Número SIP importado
ELEVENLABS_WEBHOOK_SECRET=           # Verificar firma del webhook post-llamada

# --- Calendly (ver docs/configuracion-calendly.md) ---
CALENDLY_TOKEN=                      # Personal Access Token (plan Standard o superior)
CALENDLY_EVENT_TYPE_URI=             # pnpm calendly tipos → https://api.calendly.com/event_types/XXXX
CALENDLY_WEBHOOK_SIGNING_KEY=        # openssl rand -hex 32; se usa al crear el webhook
CALENDLY_LOCATION_KIND=              # Opcional: solo si el tipo de evento tiene varias ubicaciones
CALENDLY_LOCATION=                   # Opcional: dirección o texto de esa ubicación

# --- App ---
APP_URL=http://localhost:3000
TOOLS_SECRET=                        # Bearer de /api/tools/*  (openssl rand -hex 32)
CRON_SECRET=                         # Bearer de /api/cron/*   (openssl rand -hex 32)
NEGOCIO_NOMBRE=
COSTE_MINUTO_ESTIMADO=0.12
